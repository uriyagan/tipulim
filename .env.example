# PostgreSQL connection string
DATABASE_URL="postgresql://tipulim:tipulim@localhost:5432/tipulim?schema=public"

# Auth: 32+ char secret used to sign session JWTs (HS256).
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-value-please"

# Field-level encryption (AES-256-GCM) for sensitive patient data at rest.
# MUST be a 32-byte key, base64 encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-32-bytes-base64-encoded-key=="

# Inactivity auto-logout in minutes (PRD §15.2)
SESSION_IDLE_MINUTES=10

# Re-authentication validity window in minutes for sensitive actions (PRD §15.3)
REAUTH_WINDOW_MINUTES=5

# --- AI layer (Gemini) ---
# Google Gemini API key for AI summarization (PRD §8, §10, §11).
# When empty, the app uses a deterministic offline stub so the AI flow still runs.
GEMINI_API_KEY=""
# Optional Gemini model override (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"
