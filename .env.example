# PostgreSQL connection string
DATABASE_URL="postgresql://tipulim:tipulim@localhost:5432/tipulim?schema=public"

# Auth: 32+ char secret used to sign session JWTs (HS256).
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-value-please"

# Field-level encryption (AES-256-GCM) for sensitive patient data at rest.
# MUST be a 32-byte key, base64 encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-32-bytes-base64-encoded-key=="

# Inactivity auto-logout in minutes (PRD §15.2)
SESSION_IDLE_MINUTES=10

# Re-authentication validity window in minutes for sensitive actions (PRD §15.3)
REAUTH_WINDOW_MINUTES=5

# Public base URL of the app (used to build email links). e.g. https://www.haclinica.io
APP_URL="http://localhost:3000"

# --- Transactional email (Resend) ---
# API key from resend.com. When empty, emails are logged to the console (dev).
RESEND_API_KEY=""
# Verified sender address (domain verified in Resend).
EMAIL_FROM="noreply@haclinica.io"

# --- AI layer (Gemini) ---
# Google Gemini API key for AI summarization (PRD §8, §10, §11).
# When empty, the app uses a deterministic offline stub so the AI flow still runs.
GEMINI_API_KEY=""
# Optional Gemini model override (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# --- Google Calendar sync (PRD §12, optional) ---
# OAuth client from Google Cloud Console (Calendar API enabled).
# When empty, calendar sync is disabled and shown as "not configured".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud Console, e.g.
# http://localhost:3000/api/calendar/google/callback
GOOGLE_REDIRECT_URI=""

# --- External invoicing (PRD §13, optional) ---
# Generic HTTP invoice provider endpoint + API key. When empty, an offline stub
# is used so the flow is demoable.
INVOICE_API_URL=""
INVOICE_API_KEY=""
# Shared secret to authenticate the provider's status webhook
# (POST /api/invoices/webhook with header x-webhook-secret).
INVOICE_WEBHOOK_SECRET=""

# --- Encrypted backups (PRD §17) ---
# 32-byte base64 key for backup encryption (falls back to ENCRYPTION_KEY).
BACKUP_ENCRYPTION_KEY=""
# Output directory and retention (defaults: ./backups, 30 days).
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="30"
